# PostgreSQL — used for both local dev and Railway production
# Local: brew install postgresql@16 && brew services start postgresql@16
#        createdb jlpt_companion
DATABASE_URL="postgresql://your-username@localhost:5432/jlpt_companion"

# For Railway — set via Railway dashboard (auto-provisioned)
# DATABASE_URL="postgresql://user:password@host:5432/jlpt_companion"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
